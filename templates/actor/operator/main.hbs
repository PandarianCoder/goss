<section class="tab main {{tab.cssClass}}" data-group="primary" data-tab="main">
    <div class="identity-row">
        <label>Age
            <input type="number" name="system.age" value="{{system.age}}">
        </label>
        <label>Country
            <input type="text" name="system.country" value="{{system.country}}">
        </label>
        <label>Career
            <input type="text" name="system.career" value="{{system.career}}">
        </label>
        <label>Looks
            <input type="text" name="system.looks" value="{{system.looks}}">
        </label>
    </div>

    <div class="attributes-grid">
        <label>Coordination
            <input type="number" name="system.attributes.coordination" value="{{system.attributes.coordination}}" min="0" max="7">
        </label>
        <label>Reflexes
            <input type="number" name="system.attributes.reflexes" value="{{system.attributes.reflexes}}" min="0" max="7">
        </label>
        <label>Fitness
            <input type="number" name="system.attributes.fitness" value="{{system.attributes.fitness}}" min="0" max="7">
        </label>
        <label>Agility
            <input type="number" name="system.attributes.agility" value="{{system.attributes.agility}}" min="0" max="7">
        </label>
        <label>Focus
            <input type="number" name="system.attributes.focus" value="{{system.attributes.focus}}" min="0" max="7">
        </label>
        <label>Intellect
            <input type="number" name="system.attributes.intellect" value="{{system.attributes.intellect}}" min="0" max="7">
        </label>
    </div>

    <div class="health-block">
        <label>Wounds
            <input type="number" name="system.health.wounds" value="{{system.health.wounds}}" min="0">
        </label>
        <span>/ {{system.health.max}}</span>
    </div>

    <div class="derived-stats">
        <div class="stat"><span class="label">Damage Bonus</span><span class="value">{{system.derived.damageBonus}}</span></div>
        <div class="stat"><span class="label">Defence</span><span class="value">{{system.derived.defence}}</span></div>
        <div class="stat"><span class="label">Initiative</span><span class="value">{{system.derived.initiative}}</span></div>
        <div class="stat"><span class="label">Actions</span><span class="value">{{system.derived.actions}}</span></div>
        <div class="stat"><span class="label">Encumbrance</span><span class="value">{{system.derived.encumbrance}}</span></div>
        <div class="stat"><span class="label">Perception</span><span class="value">{{system.derived.perception}}</span></div>
    </div>

    <div class="resources">
        <label>Boosts
            <input type="number" name="system.boosts" value="{{system.boosts}}" min="0" max="5">
        </label>
        <label>Advantage
            <input type="number" name="system.advantage" value="{{system.advantage}}" min="0">
        </label>
    </div>

    <div class="equipped-weapons">
        <h3>Equipped Weapon</h3>
        {{#if equippedWeapons.length}}
            <ul>
                {{#each equippedWeapons}}
                <li class="equipped-weapon" data-item-id="{{this.id}}">
                    <span class="weapon-name">{{this.name}}</span>
                    <button type="button" data-actor="rollWeaponAttack" data-item-id="{{this.id}}">
                        Attack
                    </button>
                </li>
                {{/each}}
            </ul>
        {{else}}
        <p class="empty">No weapons currently equipped.</p>
        {{/if}}
    </div>
</section>