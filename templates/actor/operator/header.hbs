<header class="operator-header">
    <img
        class="portrait"
        src="{{actor.img}}"
        data-action="editImage"
        data-edit="img"
        alt="{{actor.name}}"
    >

    <div class="identity">
        <input type="text" name="name" value="{{actor.name}}" placeholder="Operator Name">
        <input type="text" name="system.callSign" value="{{system.callSign}}" placeholder="Call Sign">
    </div>
</header>