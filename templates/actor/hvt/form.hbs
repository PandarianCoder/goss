<div class="hvt-sheet">

  // Header
  <header class="hvt-header">
    <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}">

    <div class="identity">
      <input type="text" name="name" value="{{actor.name}}" placeholder="HVT Name">
      <select name="system.tier">
        <option value="influential" {{#if (eq system.tier "influential")}}selected{{/if}}>Influential</option>
        <option value="untouchable" {{#if (eq system.tier "untouchable")}}selected{{/if}}>Untouchable</option>
      </select>
      <input type="text" name="system.role" value="{{system.role}}" placeholder="Role (e.g. Arms Dealer)">
    </div>
  </header>

  // Stats
  <div class="stats-grid">
    <label>Awareness
      <input type="number" name="system.awareness" value="{{system.awareness}}" min="0">
    </label>
    <label>Skill
      <input type="number" name="system.skill" value="{{system.skill}}" min="0">
    </label>
    <label>Ranged
      <input type="number" name="system.ranged" value="{{system.ranged}}" min="0">
    </label>
    <label>Melee
      <input type="number" name="system.melee" value="{{system.melee}}" min="0">
    </label>
    <label>Defence
      <input type="number" name="system.defence" value="{{system.defence}}" min="0">
    </label>
    <label>Morale
      <input type="number" name="system.morale" value="{{system.morale}}" min="0">
    </label>
  </div>

  // Wounds
  <div class="wounds-block">
    <label>Wounds
      <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0">
    </label>
    <span>/</span>
    <input type="number" name="system.wounds.max" value="{{system.wounds.max}}" min="0">
  </div>

  // Description
  <div class="editor-block">
    <h3>Description</h3>
    {{#if editable}}
      <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false" value="{{system.description}}">
        {{{descriptionHTML}}}
      </prose-mirror>
    {{else}}
      {{{descriptionHTML}}}
    {{/if}}
  </div>

</div>